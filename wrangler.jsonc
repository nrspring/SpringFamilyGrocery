{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spring-family-grocery",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "groceries.thespringfamily.com", "custom_domain": true }],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spring-family-grocery-db",
      "database_id": "3d392d76-54dc-4b85-985d-ea0164e2ebab",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "spring-family-grocery-photos" }],
  "observability": { "enabled": true }
}
